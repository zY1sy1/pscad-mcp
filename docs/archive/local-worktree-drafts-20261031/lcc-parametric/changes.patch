+def test_real_template_b001_frequency_stages_55_hz_without_source_mutation(tmp_path):
+    source_bytes = REAL_TEMPLATE.read_bytes()
+    source_hash = __import__("hashlib").sha256(source_bytes).hexdigest()
+    audit = audit_lcc_parameter_bindings(REAL_TEMPLATE)
+    binding = next(item for item in audit["bindings"] if item["logical_parameter"] == "frequency_hz" and item["role"] == "main_control")
+    plan = {
+        "template": {"path": str(REAL_TEMPLATE), "fingerprint": source_hash},
+        "project": {"staging_path": str(tmp_path / "b001.staging.pscx")},
+        "bindings": [{**binding, "value": "55.0 Hz", "expected_match_count": 1}],
+    }
+
+    evidence = apply_template_bindings(plan)
+
+    assert evidence["read_back"][0]["value"] == "55.0 Hz"
+    assert evidence["source_sha256"] == source_hash
+    assert REAL_TEMPLATE.read_bytes() == source_bytes
+    assert __import__("hashlib").sha256(REAL_TEMPLATE.read_bytes()).hexdigest() == source_hash
+
