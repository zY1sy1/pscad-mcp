+def test_real_template_b002_b003_ac_voltage_group_stages_both_sides(tmp_path):
+    source_bytes = REAL_TEMPLATE.read_bytes()
+    source_hash = __import__("hashlib").sha256(source_bytes).hexdigest()
+    audit = audit_lcc_parameter_bindings(REAL_TEMPLATE)
+    bindings = [item for item in audit["bindings"] if item["logical_parameter"] == "ac_voltage_kv"]
+    assert {item["role"] for item in bindings} == {"rectifier_valve_group", "inverter_valve_group"}
+    assert all(item["matches"] == 1 and item["observed_units"] == "kV" for item in bindings)
+    staging = tmp_path / "b002-b003.staging.pscx"
+    plan = {
+        "template": {"path": str(REAL_TEMPLATE), "fingerprint": source_hash},
+        "project": {"staging_path": str(staging)},
+        "bindings": [{**item, "value": "400.0 kV", "expected_match_count": 1} for item in bindings],
+    }
+
+    evidence = apply_template_bindings(plan)
+
+    assert [item["value"] for item in evidence["read_back"]] == ["400.0 kV", "400.0 kV"]
+    assert evidence["source_sha256"] == source_hash
+    assert REAL_TEMPLATE.read_bytes() == source_bytes
