<?xml version="1.0" encoding="utf-8"?>
<project name="reachable_definitions" version="4.6.2">
  <definitions>
    <Definition classid="UserCmpDefn" name="Main">
      <schematic classid="UserCanvas">
        <User classid="UserCmp" id="1" name="case:BreakerBlock" defn="case:BreakerBlock" />
        <User classid="UserCmp" id="2" name="case:LineBlock" defn="case:LineBlock" />
      </schematic>
    </Definition>
    <Definition classid="UserCmpDefn" name="BreakerBlock">
      <schematic classid="UserCanvas">
        <User classid="UserCmp" id="10" name="master:breaker1" defn="master:breaker1"><paramlist><param name="NAME" value="BRK1" /></paramlist></User>
        <User classid="UserCmp" id="11" name="master:datalabel" defn="master:datalabel"><paramlist><param name="Name" value="IMC" /></paramlist></User>
        <User classid="UserCmp" id="12" name="master:datalabel" defn="master:datalabel"><paramlist><param name="Name" value="BrkOrd1" /></paramlist></User>
        <User classid="UserCmp" id="13" name="master:ammeter" defn="master:ammeter"><paramlist><param name="Name" value="IMC" /></paramlist></User>
      </schematic>
    </Definition>
    <Definition classid="UserCmpDefn" name="LineBlock">
      <schematic classid="UserCanvas">
        <User classid="UserCmp" id="20" name="case:TL1" defn="case:TL1">
          <Port id="201" classid="Port" name="P1" /><Port id="202" classid="Port" name="P2" />
        </User>
      </schematic>
    </Definition>
    <Definition classid="UserCmpDefn" name="TL1"><schematic classid="UserCanvas" /></Definition>
    <Definition classid="UserCmpDefn" name="UnusedBlock">
      <schematic classid="UserCanvas"><User classid="UserCmp" id="99" name="UnusedBreaker" defn="master:breaker1" /></schematic>
    </Definition>
  </definitions>
</project>
