<project version="4.6.2"><canvas name="Main">
<component id="r" name="Rectifier" definition="Rectifier"/><component id="i" name="Inverter" definition="Inverter"/>
<component id="p" name="PositivePole" definition="PositivePole"/><component id="n" name="NegativePole" definition="NegativePole"/>
<component id="rn" name="RectifierNeutral" definition="NeutralBus"/><component id="in" name="InverterNeutral" definition="NeutralBus"/>
<component id="re" name="RectifierEarthElectrode" definition="EarthElectrode"/><component id="ie" name="InverterEarthElectrode" definition="EarthElectrode"/>
<component id="el" name="EarthReturnLine" definition="EarthReturnLine"/><component id="sw" name="EarthReturnSwitch" definition="EarthReturnSwitch"><parameter name="status" value="closed"/></component>
<label text="positive pole voltage"/><label text="negative pole voltage"/><label text="positive pole current"/><label text="negative pole current"/><label text="earth return current"/><label text="metallic return current"/><label text="earth return switch status"/><label text="metallic return switch status"/><label text="positive pole status"/><label text="negative pole status"/><label text="rectifier neutral voltage"/><label text="inverter neutral voltage"/><label text="dc power"/><label text="dc voltage"/>
<connection id="c1" from_component="rn" to_component="re"/><connection id="c2" from_component="re" to_component="el"/><connection id="c3" from_component="el" to_component="sw"/><connection id="c4" from_component="sw" to_component="ie"/><connection id="c5" from_component="ie" to_component="in"/>
</canvas></project>
